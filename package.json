{
  "name": "godot-mcp-server",
  "version": "0.1.0",
  "description": "Game-agnostic TypeScript MCP server bridging MCP clients and the running Godot editor",
  "license": "MIT",
  "type": "module",
  "bin": {
    "godot-mcp-server": "./dist/cli.js"
  },
  "engines": {
